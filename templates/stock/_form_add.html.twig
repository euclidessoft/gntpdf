  <!-- Button trigger modal -->
                                <button type="button"
                                        class="btn btn-success"
                                        data-bs-toggle="modal" data-bs-target="#ajoutermodal"
                                        id="ajouter">
                                    <i class="fa fa-plus"></i> {{ "Ajouter Produit"|trans }}
                                </button>
<form method="post" title="{{ 'ajouter produit'|trans }}" id="ajoutform" action="{{ path('stock_addinventaire') }}">
                                <!-- Modal -->
                                <div class="modal fade" id="ajoutermodal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered text-center">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h4 class="modal-title fs-5" id="exampleModalLabel">
                                                  Ajouter Produit </h4>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                                        aria-label="Close">

                                                </button>
                                            </div>
                                            <div class="modal-body px-5">
                                                  <div class="mt-3">
                                                   Produit:
                                                           <select name="ajoutproduit" id="ajoutproduit" class="form-control">
                                                            <option value="">-- Sélectionner un Produit--</option>
                                                           {% for produit in produits %}
                                                                <option value="{{produit.id}}">{{ produit.reference }} - {{produit.desigantion}}</option>
                                                           {% endfor %}
                                                               
                                                            </select>
                                                </div>
                                                <div class="mt-3">
                                                   Motif:
                                                           <select name="ajoutmotif" id="ajoutmotif" class="form-control">
                                                                <option value="">-- Sélectionner un motif --</option>
                                                                <option value="MANQUANT">MANQUANT</option>
                                                                <option value="CONFUSION DE SAISIE">CONFUSION DE SAISIE</option>
                                                                <option value="REGULARISATION">REGULARISATION</option>
                                                                <option value="EN PLUS">EN PLUS</option>
                                                                <option value="ERREUR STOCK">ERREUR STOCK</option>
                                                            </select>
                                                </div>
                                                <div class="mt-3">
                                                    Quantité:
                                                    <label for="quantite"></label>
                                                    <input type="number" class="form-control"
                                                           id="ajoutquantite"   name="ajoutquantite">
                                                </div>
                                                <div class="mt-3">
                                                    Numero de lot:
                                                    <label for="lot"></label>
                                                    <input type="text" class="form-control"
                                                           id="ajoutlot"   name="ajoutlot">
                                                </div>
                                                
                                                <div class="mt-3">
                                                    Date de Peremption:
                                                    <label for="peremption"></label>
                                                    <input type="date" class="form-control"
                                                           id="ajoutperemption"   name="ajoutperemption">
                                                </div>

                                            </div>
                                            <div class="modal-footer px-5 py-4">
                                                
                                                 <button type="button" class="btn btn-secondary ms-5" data-bs-dismiss="modal"
                                                        id="annuler">Annuler
                                                </button>
                                                <button type="button" class="btn btn-success ms-3"
                                                        id="btnajouter"
                                                        onclick="addinventaire()">
                                                    <i class="fa fa-plus"></i> Ajouter
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                </form>