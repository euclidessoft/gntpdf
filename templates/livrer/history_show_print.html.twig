<!doctype html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

    <title>	&nbsp;</title>
    <style>
        .titre {
            font-family: Verdana, Geneva, Tahoma, sans-serif;
            font-size: 30px;
            font-weight: bold;
            color: #039c4f;
        }

        .text {
            font-size: 14px;
        }

        .badge {
            background-color: red !important;
        }

        @media print {
            .table-success-light {
                color: #000 !important;
            }

            .table-bordered {
                border: 1px solid #000 !important;
            }

            thead {
                background-color: #c5fbae !important;
                color: #000;
            }

            .tt {
                display: inline-block;
                border: none;
                width: 180px !important;
            }
        }
    </style>

</head>
<body onload="print()" onafterprint="document.location.href='{{ path('livraison_historique') }}'">
<div class="container-fluid">


    <div class="col-lg-8 offset-lg-2">
        <div class="row" style="border-bottom: 1px solid #039c4f;padding-bottom: 20px;">
            <div class="col-2">
                <img src="{{ asset('images/gntpharma.jpeg') }}" alt="Logo" class="w-100">
            </div>
            <div class="col-10 text-center">
                <div class="row">
                    <div class="col-12 titre text-center">
                        GNT PHARMA
                    </div>
                    <div class="col-12 text">
                        BP : 3582 Yaoundé – Cameroun, NGOUSSO
                        <br>
                        Montée Éleveur Immeuble Sainte Marie
                    </div>
                    <div class="col-12 text">
                        +237 69 71 49 4 12 / +237 67 52 47 865
                    </div>
                    <div class="col-12 text">
                        info@gntpharma-cameroun.com / www.gnt-pharma.com
                    </div>
                    <!-- <div class="col-12 fw-bold">

                    </div> -->
                </div>
            </div>
        </div>
        <div class="row justify-content-end">
            <div class="col-5">
            <h5 class="text-center fw-bold text-uppercase mt-5">
             Yaoundé, le {{ livrer.date|date("d/m/Y")}}
            </h5>
            </div>
        </div>
         <h4 class="text-center fw-bold text-uppercase mt-4">
            {{ 'Bordereau de livraison'|trans }}
        </h4>
        <h6 class="text-center text-uppercase">
            {{ 'Numero'|trans }} : {{ livrer.id }}
        </h6>
<h5 class="text-uppercase fw-bold mt-4">Doit: {{ livrer.commande.user.nom }} </h5>
<h5 class="text-uppercase fw-bold mb-4"> Objet: Achat de produit pharmaceutique</h5>
             
    <table class="table table-success-light table-bordered table-hover table-striped w-100 text-center">
                <thead>
                <tr>
                <th>N°</th>
                <th>CIP</th>
                <th>Desigantion</th>
                <th>Qté</th>
                <th>Date de peremption</th>
                <th>numero lot</th>
                </tr>
                </thead>
                     <tbody>
                     {% set entete = 0 %}
            {% set produit = 0 %}
            {% set quantite = 0 %}
            
                {% set num = 1 %}
            {% for  commande in livraison %}
                {% set ug = commande.ug %}
                <tr>

                    <td>{{ num }}  {% set num = num + 1 %}</td>
                    <td>{{ commande.produit.reference }}</td>
                    <td>{{ commande.produit.desigantion }}</td>
                    <td> {{ commande.quantitelivrer }}</td>
                    <td>{{ commande.peremption|date('d/m/Y') }}</td>
                    <td>{{ commande.lot }}</td>


                </tr>
            {% endfor %}
                </tbody>
              
            </table>
            <div class="row">
                <div class="col-1">
               
                </div>
                <div class="col-2">
                <h5 class="text-uppercase fw-bold mt-4">Le client</h5>
                </div>
                <div class="col-5">
                </div>
                <div class="col-3">
                <h5 class="text-uppercase fw-bold mt-4"> ordonateur</h5>
                </div>

                <div class="col-1">
                </div>
            </div>
        {# <div class="col-4 mb-2 text-end">
            {% if commandereference.livrer == 1 %}
                <img src="{{ asset(livrer[0].signature) }}" alt="">
            {% endif %}
        </div> #}
  
</body>

</html>
