{% extends
    'print.html.twig'
%}

{% block contenu %}
<div class="container-fluid mt-4"> 
<h3 class="mt-4 fw-bold">
        <i class="fas fa-chart-line me-2"></i>
        {{ "Analyse Fournisseur"|trans }} | {{ user.designation}} 
    </h3>
    <h5 class="mt-4 mb-5 fw-bold">
        <i class="fa fa-shopping-cart me-2"></i>
        {{ "Palmares des achats d'Articles"|trans }}
    </h5>
     
    <table class="table table-success-light table-bordered table-hover table-striped my-3">
        <thead>
        <tr>
            <th>{{ 'CIP'|trans }}</th>
            <th>{{ 'Désignation'|trans }}</th>
            <th>{{ 'DCI'|trans }}</th>
            <th>{{ 'Fabricant'|trans }}</th>
            <th>{{ 'Actions'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for produit in produits %}
            <tr>
                <td>{{ produit.reference }}</td>
                <td>{{ produit.desigantion }}</td>
                <td>{{ produit.dci }}</td>
                <td>{{ produit.fabriquant }}</td>
                <td>
                    <a id="{{ produit.id }}" onclick="load({{ produit.id }})" class="btn btn-success" href="{{ path('vente_fournisseur_show', {'fournisseur': user.id, 'produit': produit.id}) }}">
                        <i class="fa fa-eye"></i>
                    </a>
                </td>

            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
