{% extends 'print.html.twig' %}
{% block contenu %}
    <div class="container-fluid mt-4 fond-7">
        <h3 class="mt-4 fw-bold">
            <i class="fas fa-chart-line me-2"></i>
            {{ "Analyse Client"|trans }} | {{ user.nom ~ " " ~ user.prenom }}
        </h3>
        <h5 class="mt-4 mb-5 fw-bold">
            <i class="fa fa-shopping-cart me-2"></i>
            {{ "Palmares des ventes Articles"|trans }}
        </h5>

        <table class="table table-success-light table-bordered table-hover table-striped mb-3">
            <thead>

            <tr>
                <th>{{ produit.reference }}</th>
                <th>{{ produit.desigantion }}</th>
                <th class="text-center">{{ produit.dci ? produit.dci : "-" }}</th>
                <th>{{ produit.fabriquant }}</th>
            </tr>
            <tr>
                <td colspan="4">&emsp;</td>
            </tr>
            <tr>
                <th colspan="2" class="text-center"><b>{{ "Quantité Totale Vendue"|trans }}
                        : {{ quantite|number_format(0, '', ' ') }}</b></th>
                <th colspan="2" class="text-center"><b>{{ "Chiffre d'affaire"|trans }}
                        : {{ montant|number_format(2, app.request.locale == 'fr' ? ',' : '.', app.request.locale == 'fr' ? ' ' : ',') }}</b>
                </th>
            </tr>
            </thead>

        </table>


        <table class="table table-success-light table-bordered table-hover table-striped my-3">
            <thead>

            <tr>
                <th>{{ 'Date'|trans }}</th>
                <th>{{ 'commande'|trans }}</th>
                <th>{{ 'Quantité vendue'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for produit in ventes %}
                <tr>
                    <td>{{ produit.commande.date|date("d/m/Y") }}</td>
                    <td>
                        {{ produit.commande.id }}
                    </td>
                    <td>{{ produit.quantite|number_format(0,',' , ' ') }}</td>

                </tr>
            {% endfor %}
            </tbody>
            <tr>
                <th colspan="2" class="text-center">{{ "Quantité Totale Vendue"|trans }}
                    : {{ quantite|number_format(0, '', ' ') }}</th>
                <th class="text-center">{{ "Chiffre d'affaire"|trans }}: {{ montant|number_format(0, '', ' ') }}</th>
            </tr>
        </table>
    </div>
{% endblock %}
